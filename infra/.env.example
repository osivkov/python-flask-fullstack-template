# Deployment settings. `make init` copies this to infra/.env.
# Public values only. Keep project and volume names stable after first startup.
COMPOSE_PROJECT_NAME=webapp-local
POSTGRES_VOLUME_NAME=webapp-local-postgres

# Nginx listens only on this machine in local mode.
SITE_ADDRESS=http://localhost
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080

# Image identity. Use an immutable version such as a Git commit SHA for releases.
BACKEND_IMAGE=webapp-backend
FRONTEND_IMAGE=webapp-frontend
APP_VERSION=dev

# App settings belong to app/backend/.env and app/frontend/.env.
# Memory budgets and logging limits are explicit in compose.yaml.
