# Copy to infra/.env.production with `make init-prod`, then edit for your server.
# Public placeholders only. Never put real passwords, API tokens or private keys here.
# make init-prod generates DB passwords in the repository's ignored secrets/.
COMPOSE_PROJECT_NAME=webapp-production
POSTGRES_VOLUME_NAME=webapp-production-postgres

# HTTP origin behind a separate TLS proxy. See docs/DEPLOYMENT.md.
SITE_ADDRESS=https://app.example.com
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080

# Publish this immutable image before deployment, for example ghcr.io/acme/myapp:COMMIT_SHA.
BACKEND_IMAGE=ghcr.io/owner/repository-backend
FRONTEND_IMAGE=ghcr.io/owner/repository-frontend
APP_VERSION=REPLACE_WITH_IMMUTABLE_TAG

# App settings live in app/backend/.env and app/frontend/.env on each host.
# Tune the explicit memory budgets in compose.yaml for your workload.
