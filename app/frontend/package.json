{
  "name": "flask-template-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15 <25"
  },
  "scripts": {
    "dev": "vite --configLoader native --host 0.0.0.0 --port 8080 --strictPort",
    "build": "npm run check && vite build --configLoader native",
    "preview": "vite preview --configLoader native --host 0.0.0.0 --port 8080",
    "check": "tsc --noEmit",
    "test": "vitest run --configLoader native"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
