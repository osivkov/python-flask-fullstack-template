# Backend settings. Copy to app/backend/.env; never commit the actual file.
# The PostgreSQL init hook uses DB_NAME and DB_USER from this same file.
# Changing these values does not change an already initialized database.
DB_HOST=postgres
DB_PORT=5432
DB_NAME=app
DB_USER=app
# Passwords are mounted at runtime, never placed in env examples or images.
DB_PASSWORD_FILE=/run/secrets/db_app_password
